{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "White", "color": "#FFFFFF" },
				{ "slug": "canvas", "name": "Canvas", "color": "#F6F7F4" },
				{ "slug": "line", "name": "Line", "color": "#E1E5E0" },
				{ "slug": "muted", "name": "Muted text", "color": "#5D6B66" },
				{ "slug": "text", "name": "Text", "color": "#33433E" },
				{ "slug": "ink", "name": "Ink", "color": "#0B1B17" },
				{ "slug": "brand", "name": "Brand green", "color": "#0B6E55" },
				{ "slug": "brand-dark", "name": "Brand green dark", "color": "#08533F" },
				{ "slug": "brand-soft", "name": "Brand green soft", "color": "#E4F2EC" },
				{ "slug": "accent", "name": "Amber", "color": "#F5A524" },
				{ "slug": "accent-soft", "name": "Amber soft", "color": "#FEF3DC" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "2XL", "size": "clamp(3.5rem, 7vw, 6rem)" },
				{ "slug": "80", "name": "3XL", "size": "clamp(4.5rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-latin-wght-normal.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "display", "name": "Display", "size": "3.5rem", "fluid": { "min": "2.375rem", "max": "3.75rem" } }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 1px 2px rgba(11,27,23,.06), 0 8px 24px rgba(11,27,23,.06)" },
				{ "slug": "lifted", "name": "Lifted", "shadow": "0 2px 4px rgba(11,27,23,.06), 0 24px 48px -12px rgba(11,27,23,.18)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--text)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)",
				"top": "0",
				"bottom": "0"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--inter)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--brand)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--brand-dark)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.03em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "letterSpacing": "-0.01em" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "letterSpacing": "0" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "10px" },
				"spacing": {
					"padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.3rem", "right": "1.3rem" }
				},
				"typography": {
					"fontSize": "1rem",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--brand-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "500" }
			},
			"core/site-title": {
				"typography": { "fontSize": "1.125rem", "fontWeight": "700", "letterSpacing": "-0.01em" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--brand)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.25rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--canvas)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.875rem" },
				"border": { "radius": "10px", "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.25rem", "right": "1.25rem" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (full width, no title)", "postTypes": [ "page" ] }
	]
}
